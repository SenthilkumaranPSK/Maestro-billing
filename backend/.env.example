# Copy this file to .env and adjust as needed.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="file:../../database/studio.db"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
HOST=127.0.0.1
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Add LAN address here if you access the app from another device on the network.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ─── Security ────────────────────────────────────────────────────────────────
# Generate a real secret before running in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=__GENERATE_ON_FIRST_RUN__

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
